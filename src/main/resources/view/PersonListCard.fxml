<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" spacing="14" styleClass="person-card"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <StackPane styleClass="person-avatar">
    <Label fx:id="initials" styleClass="avatar-label" />
  </StackPane>
  <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
    <HBox alignment="BASELINE_LEFT" spacing="8">
      <Label fx:id="name" styleClass="card-name" text="\$first" />
      <Label fx:id="id" styleClass="card-index" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="contact-row">
      <Label fx:id="phone" styleClass="card-meta" text="\$phone" />
      <Label fx:id="email" styleClass="card-meta" text="\$email" />
    </HBox>
    <Label fx:id="address" styleClass="card-address" text="\$address" />
    <Label fx:id="remark" styleClass="cell_small_label" text="\$remark" />
    <FlowPane fx:id="tags" hgap="6" vgap="5" />
  </VBox>
</HBox>
