<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="student-detail-modal" maxWidth="700.0" maxHeight="760.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <HBox alignment="CENTER_LEFT" spacing="14" styleClass="detail-modal-header">
    <StackPane styleClass="detail-avatar">
      <Label fx:id="initials" styleClass="detail-avatar-label" />
    </StackPane>
    <VBox spacing="3" HBox.hgrow="ALWAYS">
      <Label text="STUDENT PROFILE" styleClass="detail-eyebrow" />
      <Label fx:id="name" styleClass="detail-name" wrapText="true" />
      <Label text="Complete student record" styleClass="detail-subtitle" />
    </VBox>
    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleClose" text="×"
            styleClass="modal-close-button" />
  </HBox>

  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="detail-scroll-pane" VBox.vgrow="ALWAYS">
    <VBox spacing="16" styleClass="detail-content">
      <Label text="Contact and tutoring details" styleClass="detail-section-title" />
      <GridPane hgap="24" vgap="14" styleClass="detail-grid">
        <columnConstraints>
          <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
          <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <Label text="Phone" styleClass="detail-label" GridPane.rowIndex="0" />
        <Label fx:id="phone" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1" />
        <Label text="Email" styleClass="detail-label" GridPane.rowIndex="1" />
        <Label fx:id="email" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1"
               GridPane.rowIndex="1" />
        <Label text="Subjects" styleClass="detail-label" GridPane.rowIndex="2" />
        <Label fx:id="subjects" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1"
               GridPane.rowIndex="2" />
        <Label text="Level" styleClass="detail-label" GridPane.rowIndex="3" />
        <Label fx:id="level" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1"
               GridPane.rowIndex="3" />
        <Label text="Notes" styleClass="detail-label" GridPane.rowIndex="4" />
        <Label fx:id="notes" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1"
               GridPane.rowIndex="4" />
        <Label text="Address" styleClass="detail-label" GridPane.rowIndex="5" />
        <Label fx:id="address" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1"
               GridPane.rowIndex="5" />
        <Label text="Tags" styleClass="detail-label" GridPane.rowIndex="6" />
        <Label fx:id="tags" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1"
               GridPane.rowIndex="6" />
      </GridPane>
    </VBox>
  </ScrollPane>

  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="detail-modal-footer">
    <Label text="Press [esc] to close" styleClass="modal-hint" />
    <Region HBox.hgrow="ALWAYS" />
    <Button mnemonicParsing="false" onAction="#handleClose" text="Close" styleClass="primary-button" />
  </HBox>
</VBox>
